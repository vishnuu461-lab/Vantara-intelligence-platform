# ============================================================
# Vantara – .gitignore
# ============================================================

# --- Virtual Environment ---
venv/
env/
.venv/
C:/Vantara-venv/

# --- Environment Variables (NEVER push real credentials!) ---
.env
frontend/.env

# --- Python Cache Files ---
__pycache__/
*.pyc
*.pyo
*.pyd

# NOTE: ML model .pkl files ARE committed to allow cloud deployment
# on Render without requiring a separate training step.
# Models are small enough (~370KB total) to include in the repo.

# --- Database Files ---
*.db
*.sqlite3

# --- Upload Temp Files ---
uploads/

# --- IDE / Editor Files ---
.vscode/
.idea/
*.swp

# --- OS Files ---
.DS_Store
Thumbs.db

# --- Logs ---
*.log
logs/

# --- Node ---
node_modules/
frontend/node_modules/

# --- Build output ---
frontend/dist/

# --- Pytest cache ---
.pytest_cache/
