# ============================================================
# Vantara – Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to GitHub.
#
#   cp .env.example .env
# ============================================================

# --- Database Configuration ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vantara_db
DB_USER=root
DB_PASSWORD=

# --- Flask Configuration ---
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=change-this-to-a-long-random-secret-in-production

# --- Application Configuration ---
APP_PORT=5000

# --- CORS: Your deployed Vercel frontend URL (production only) ---
# Example: https://vantara.vercel.app
FRONTEND_URL=http://localhost:5173
